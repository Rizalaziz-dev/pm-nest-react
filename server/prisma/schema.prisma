// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PM
  OPERATOR_DWG          // The 6 Engineers
  REQUESTER         // The Customer
  PRODUCTION_LEAD   // (Level 2) Shop Floor Supervisor
}

enum ProjectScope {
  NEW_ASSY      // 100 Points
  MODIF_MAJOR   // 60 Points
  MODIF_MINOR   // 20 Points
}

enum ProjectType {
  REGULAR
  PROTOTYPE
}

// THE 6 ENGINEERING TASKS (Virtual Work)
enum ProcessName {
  JOINT_DRAWING
  HOUSING_DRAWING
  JIG_DRAWING
  VISUAL_DRAWING
  JOB_STATION_ACC
  JOB_STATION_FINISHING
}

// THE PRODUCTION STAGES 
enum ProductionStage {
  PLANNING          // Engineering phase
  PP                // Wires cut, Jointing
  HOUSING           // Connector Insertion
  ASSEMBLING        // On the JIG Board
  JS_ACC            // Acccesiries installation
  VISUAL            // Cheking for dimension, etc
  CHECKER           // Continuity check
  JS_FINISHING      // Final touches
  PREDEL            // Final Inspection
}

enum WorkOrderStatus {
  LOCKED          // Waiting for Breakdown
  PENDING         // Breakdown done, Ready to Pull
  IN_PROGRESS     // In Operator's "Cart"
  COMPLETED
  BLOCKED         // Issue reported
  REWORK
}

enum AssetType {
  REFERENCE
  DRAFT_FILE
  FINAL_DELIVERY
  REVISION_IMG
}

// --- MODELS ---

model User {
  id    String     @id @default(cuid(2))
  name  String
  email String  @unique
  password String
  role UserRole @default(OPERATOR_DWG)
  createdAt DateTime @default(now())

  // RELATIONS  
  assignedOrders   WorkOrder[]  
  managedProjects  Project[]    @relation("PM_Projects")
  uploadedAssets   Asset[]
  authoredRevisions Revision[]

  @@map("users")
}

model Project {
  id               String          @id @default(cuid(2))
  assyNumber       String          @unique // "821-4402-AB"
  customer         String          
  totalPo          String          
  
  // CONFIGURATION
  plotting         ProjectType     @default(REGULAR)
  scope            ProjectScope    @default(NEW_ASSY) // New vs Modif
  breakdownDays    Int             @default(5)        // How long Phase 1 takes
  
  // DATES
  orderDate        DateTime
  etd              DateTime
  
  // STATUS TRACKING
  engineeringStatus String         @default("IN_PROGRESS") 
  productionStage  ProductionStage @default(PLANNING)
  
  // LOGIC: When does Phase 2 (Engineering) actually start?
  // Calculated as: OrderDate + breakdownDays
  breakdownFinishDate DateTime?
  createdAt        DateTime        @default(now())

  // RELATIONS
  pmId             String
  pm               User            @relation("PM_Projects", fields: [pmId], references: [id])
  workOrders       WorkOrder[]     
  assets           Asset[]       
  revisions        Revision[]    

  @@map("projects")
}

model WorkOrder {
  id             String          @id @default(cuid(2))
  processName    ProcessName
  status         WorkOrderStatus @default(LOCKED) // Starts Locked until BD is done

  // THE SMART QUEUE LOGIC
  targetDate     DateTime        // "Soft Goal" (Start Date + Process Time)
  hardDeadline   DateTime        // "The Wall" (Target + Buffer)
  
  // Actual tracking
  operatorNote   String?         @db.Text
  completedAt    DateTime?

  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?           @relation(fields: [assignedUserId], references: [id])

  @@map("work_orders")
}

model Revision {
  id             String   @id @default(cuid(2))
  comment        String   @db.Text
  screenshotUrl  String?  
  resolved       Boolean  @default(false)
  
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String   
  author         User     @relation(fields: [authorId], references: [id])
  createdAt      DateTime @default(now())

  @@map("revisions")
}

model Asset {
  id             String    @id @default(cuid(2))
  url            String    
  fileType       AssetType
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId     String
  uploader       User      @relation(fields: [uploaderId], references: [id])
  createdAt      DateTime  @default(now())

  @@map("assets")
}